<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}odds{% endblock %}</title>
<link rel="stylesheet" href="{{ url_path('static', path='app.css') }}">
<script src="{{ url_path('static', path='vendor/htmx.min.js') }}" defer></script>
{% block head %}{% endblock %}
</head>
<body>
