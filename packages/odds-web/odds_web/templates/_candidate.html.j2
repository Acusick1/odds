{% from "_macros.html.j2" import section_state %}
<div id="candidate" hx-get="{{ url_path('candidate_fragment', name=name, version=version) }}?page={{ page }}" hx-trigger="every 60s" hx-swap="outerHTML">
{{ section_state(candidate) }}
{% if candidate.value is not none %}
{% set c = candidate.value %}
<div class="{{ 'stale' if candidate.failure }}">
<h3 class="title"><b>{{ c.name }}</b> <span class="sub num">v{{ c.version }}</span>
<span class="status">{{ c.status }}</span>
<span class="sub">{{ c.scope }}</span>
<span class="verdict">{{ c.verdict }}</span>{% if c.verdict_note %} <span class="sub">{{ c.verdict_note }}</span>{% endif %}</h3>

{% include "_backtest.html.j2" %}

<div class="tiles">
  <div class="tile"><div class="k">Bets with a close</div>
    <div class="v num">{{ c.bets_with_close }}{% if c.progress %}<span class="sub"> / {{ c.progress.next_checkpoint }}</span>{% endif %}</div>
    <div class="sub num">{{ c.settled_bets }} settled{% if c.pending_bets %} · {{ c.pending_bets }} not yet final{% endif %}</div></div>
  <div class="tile"><div class="k">Mean EV vs close</div>
    {% if c.current %}
    <div class="v num {{ 'pos' if c.current.mean_ev >= 0 else 'neg' }}">{{ c.current.mean_ev | percent }}</div>
    <div class="sub num">95% CI {{ c.current.ci95[0] | percent }} … {{ c.current.ci95[1] | percent }}</div>
    {% else %}<div class="v sub">{{ c.no_ev_reason }}</div>{% endif %}</div>
  <div class="tile"><div class="k">P&amp;L (stake units)</div>
    <div class="v num">{{ c.pnl | signed }}u</div><div class="sub num">ROI {{ c.roi | percent }}</div></div>
  {% if c.decisions %}
  <div class="tile"><div class="k">Decisions missed</div>
    {% if c.decisions.total %}
    <div class="v num">{{ (c.decisions.missed_share * 100) | round | int }}%</div>
    <div class="sub num">{{ c.decisions.missed }} of {{ c.decisions.total }}</div>
    {% else %}<div class="v sub">no decisions</div>{% endif %}</div>
  {% endif %}
</div>

{% if c.series %}
<h3>Mean EV as bets accumulate</h3>
<div class="sub">Running mean EV over the bets with a close in the settled, final prefix. Intervals are drawn only at the checkpoints reached and at the current n; a current estimate at a checkpoint's n with a larger family sits just left of it. The verdict is read only at checkpoints.</div>
<div class="chart" data-chart="ev" data-series='{{ c.series.ev_chart() | tojson }}'></div>
<div class="legend"><span><svg width="26" height="10"><line class="ci" x1="2" y1="5" x2="24" y2="5"/></svg>95% CI</span><span><svg width="26" height="10"><line class="promote" x1="2" y1="5" x2="24" y2="5"/></svg>promote CI</span><span>Dashed lines: zero EV, checkpoints</span></div>

<h3>Expected profit vs realised P&amp;L</h3>
<div class="sub">Cohort: settled bets with a close in the scoreable prefix ({{ c.bets_with_close }}); other bets are not in either line.</div>
<div class="chart" data-chart="cumulative" data-series='{{ c.series.cumulative_chart() | tojson }}'></div>
<div class="legend"><span><span class="sw sw-expected"></span>Σ stake·EV (signal)</span><span><span class="sw sw-pnl"></span>P&amp;L (signal + luck)</span></div>
{% else %}
<h3>Mean EV as bets accumulate</h3>
<p class="sub">{{ c.no_ev_reason }}</p>
{% endif %}

{% if c.leagues %}
<h3>Per league</h3>
<div class="sub">For information: the verdict is the pooled series' above, and no league's figures change it.</div>
<table id="leagues">
<thead><tr><th>League</th><th class="r">Settled</th><th class="r">With a close</th><th class="r">Mean EV</th><th class="r">P&amp;L</th></tr></thead>
<tbody class="num">
{% for l in c.leagues %}
<tr><td class="text">{{ l.sport_key }}</td><td class="r">{{ l.settled_bets }}</td><td class="r">{{ l.bets_with_close }}</td>
<td class="r {{ ('pos' if l.mean_ev >= 0 else 'neg') if l.mean_ev is not none }}">{{ l.mean_ev | percent if l.mean_ev is not none else '—' }}</td>
<td class="r">{{ l.pnl | signed(2) }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endif %}

{% if c.book_replay %}
{% set r = c.book_replay.replay %}
<h3 id="book-sets">Book sets <span class="sub">{{ r.decisions }} recorded decisions replayed</span></h3>
<div class="sub">For information: the version's recorded decisions rebuilt from their recorded inputs under each book set and with each book left out, scored against the same close. No checkpoint, verdict or family count reads them; to act on one, register a new version with that set.</div>
<table id="book-sets-table">
<thead><tr><th>Book set</th><th class="r">Bets</th><th class="r">With a close</th><th class="r">Mean EV</th><th class="r">P&amp;L</th></tr></thead>
<tbody class="num">
{% for s in r.sets %}
<tr><td class="text">{{ s.books.value }}{% if s.registered %} <span class="sub">registered</span>{% endif %}</td>
<td class="r">{{ s.score.bets }}</td><td class="r">{{ s.score.bets_with_close }}</td>
<td class="r {{ ('pos' if s.score.mean_ev >= 0 else 'neg') if s.score.mean_ev is not none }}">{{ s.score.mean_ev | percent }}</td>
<td class="r">{{ s.score.pnl | signed(2) }}</td></tr>
{% endfor %}
</tbody>
</table>
<div class="chart" data-chart="booksets" data-series='{{ c.book_replay.chart() | tojson }}'></div>
<div class="legend">{% for s in r.sets %}<span><svg width="26" height="10"><line class="{{ 'bookset-registered' if s.registered else 'bookset-other' }}" x1="2" y1="5" x2="24" y2="5"/></svg>{{ s.books.value }}{% if s.registered %} (registered){% endif %}</span>{% endfor %}<span>Running mean EV over the bets with a close</span></div>

<h3>Per book</h3>
<div class="sub">Books with a trade placed at them, or whose removal changes the replay. Without: the version's own book set less that book.</div>
<table id="books">
<thead><tr><th rowspan="2">Book</th><th class="r" colspan="3">Placed there</th><th class="r" colspan="4">Without this book</th></tr>
<tr><th class="r">Bets</th><th class="r">Mean EV</th><th class="r">P&amp;L</th><th class="r">Bets</th><th class="r">With a close</th><th class="r">Mean EV</th><th class="r">P&amp;L</th></tr></thead>
<tbody class="num">
{% for b in r.books %}
<tr><td class="text">{{ b.book }}</td>
<td class="r">{{ b.placed.bets }}</td>
<td class="r {{ ('pos' if b.placed.mean_ev >= 0 else 'neg') if b.placed.mean_ev is not none }}">{{ b.placed.mean_ev | percent }}</td>
<td class="r">{{ b.placed.pnl | signed(2) }}</td>
<td class="r">{{ b.without.bets }}</td><td class="r">{{ b.without.bets_with_close }}</td>
<td class="r {{ ('pos' if b.without.mean_ev >= 0 else 'neg') if b.without.mean_ev is not none }}">{{ b.without.mean_ev | percent }}</td>
<td class="r">{{ b.without.pnl | signed(2) }}</td></tr>
{% else %}
<tr><td colspan="8" class="sub">No book to show.</td></tr>
{% endfor %}
</tbody>
</table>
{% endif %}

{% if c.decisions %}
<h3>Decisions, last {{ c.decisions.days | length }} days</h3>
<div class="legend"><span><span class="sw sw-bet"></span>bet</span><span><span class="sw sw-no-bet"></span>no bet</span><span><span class="sw sw-missed"></span>missed (no input)</span></div>
<div class="scroll"><div class="timeline">
{% for day in c.decisions.days %}
<div class="day"><div class="marks">{% for d in day.decisions %}<i class="mark mark-{{ d.kind.name | lower | replace('_', '-') }}" title="{{ d.kind.value }}: {{ d.event }} at {{ d.decision_time.strftime('%H:%M') }}"></i>{% endfor %}</div><span class="sub num">{{ day.day.strftime('%b %d') }}</span></div>
{% endfor %}
</div></div>
{% endif %}

<h3>Bet ledger <span class="sub">{{ c.ledger.total }} trades</span></h3>
<div class="scroll">
<table id="ledger">
<thead><tr><th>Placed</th><th>Event</th><th>Sel.</th><th>Book</th><th class="r">Stake</th><th class="r">Price</th><th class="r">p_close</th><th class="r">EV</th><th>Result</th><th class="r">P&amp;L</th></tr></thead>
<tbody class="num">
{% for r in c.ledger.rows %}
<tr class="{{ 'void' if r.is_void }}">
<td>{{ r.placed_at.strftime('%b %d %H:%M') }}</td>
<td class="text">{{ r.event }}</td>
<td class="text">{{ r.selection }}{% if r.line is not none %} {{ r.line }}{% endif %}</td>
<td class="text">{{ r.bookmaker }}</td>
<td class="r">{{ '%g' | format(r.stake) }}</td>
<td class="r">{{ '%.2f' | format(r.price) }}</td>
<td class="r">{{ '%.3f' | format(r.p_close) if r.p_close is not none else '—' }}</td>
<td class="r {{ ('pos' if r.ev >= 0 else 'neg') if r.ev is not none }}">{{ r.ev | percent }}</td>
<td class="text">{{ r.result.value if r.result else 'pending' }}</td>
<td class="r">{{ (r.pnl | signed(2)) if r.pnl is not none else '—' }}</td>
</tr>
{% else %}
<tr><td colspan="10" class="sub">No trades.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% if c.ledger.pages > 1 %}
{% set here = url_path('candidate', name=name, version=version) %}
<p class="pager sub">
{% if c.ledger.page > 1 %}<a href="{{ here }}?page={{ c.ledger.page - 1 }}">‹ newer</a>{% endif %}
page {{ c.ledger.page }} of {{ c.ledger.pages }}
{% if c.ledger.page < c.ledger.pages %}<a href="{{ here }}?page={{ c.ledger.page + 1 }}">older ›</a>{% endif %}
</p>
{% endif %}
</div>
{% endif %}
</div>
