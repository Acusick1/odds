{% from "_macros.html.j2" import section_state %}
<div id="portfolio" hx-get="{{ url_path('portfolio_fragment') }}" hx-trigger="every 60s" hx-swap="outerHTML">
{{ section_state(portfolio) }}
{% if portfolio.value is not none %}
<div class="scroll">
<table id="pf" class="{{ 'stale' if portfolio.failure }}">
<thead><tr>
<th>Candidate</th><th>Next checkpoint</th>
<th>Mean EV, 95% CI <span class="num axis-label">(−{{ axis_percent }}% … +{{ axis_percent }}%)</span></th>
<th class="r">P&amp;L</th><th>Verdict</th>
</tr></thead>
<tbody>
{% for row in portfolio.value %}
<tr>
<td><a href="{{ url_path('candidate', name=row.name, version=row.version) }}"><b>{{ row.name }}</b></a> <span class="sub num">v{{ row.version }}</span> <span class="status">{{ row.status }}</span>
<div class="sub">{{ row.scope }}</div></td>
<td>{% if row.progress %}
<span class="bar"><i style="width: {{ (row.progress.fraction * 100) | round | int }}%"></i></span><span class="num">{{ row.progress.bets_with_close }} / {{ row.progress.next_checkpoint }}</span>
{% else %}<span class="sub">—</span>{% endif %}</td>
<td class="fp">{% if row.forest %}{% set f = row.forest %}
<svg width="{{ forest_width + 56 }}" height="18" role="img" aria-label="mean EV {{ f.mean_percent | signed }}%">
<title>{{ row.name }} v{{ row.version }}
mean EV {{ f.mean_percent | signed }}%
95% CI {{ f.ci95_percent[0] | signed }} … {{ f.ci95_percent[1] | signed }}
promote CI {{ f.promote_percent[0] | signed }} … {{ f.promote_percent[1] | signed }}
n={{ f.n }}</title>
<line class="zero" x1="{{ f.zero_x }}" x2="{{ f.zero_x }}" y1="0" y2="18"/>
<line class="promote" x1="{{ f.promote_x[0] }}" x2="{{ f.promote_x[1] }}" y1="9" y2="9"/>
<line class="ci" x1="{{ f.ci95_x[0] }}" x2="{{ f.ci95_x[1] }}" y1="9" y2="9"/>
{% if f.clipped_low %}<text class="clip" x="0" y="13">‹</text>{% endif %}
{% if f.clipped_high %}<text class="clip" x="{{ forest_width - 6 }}" y="13">›</text>{% endif %}
<circle class="{{ 'pos' if f.mean_percent >= 0 else 'neg' }}" cx="{{ f.mean_x }}" cy="9" r="4"/>
<text x="{{ forest_width + 6 }}" y="13">{{ f.mean_percent | signed }}%</text>
</svg>
{% else %}<span class="sub">{{ row.no_ev_reason }}</span>{% endif %}</td>
<td class="r num">{{ row.pnl | signed }}u</td>
<td><span class="verdict">{{ row.verdict }}</span>{% if row.verdict_note %} <span class="sub">{{ row.verdict_note }}</span>{% endif %}</td>
</tr>
{% else %}
<tr><td colspan="5" class="sub">No candidates registered and no candidate trades.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
<div class="legend">
<span><svg width="26" height="10"><line class="ci" x1="2" y1="5" x2="24" y2="5"/></svg>95% CI</span>
<span><svg width="26" height="10"><line class="promote" x1="2" y1="5" x2="24" y2="5"/></svg>promote CI (99%/k)</span>
<span>Dashed line = zero EV</span>
<span>Estimate over all bets with a close; the verdict is read only at checkpoints</span>
</div>
{% endif %}
</div>
