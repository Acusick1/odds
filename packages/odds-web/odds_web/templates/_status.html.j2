{% from "_macros.html.j2" import section_state %}
{% set s = status.value %}
{% if s is none %}{{ section_state(status) }}{% else %}
{% if status.failure %}{{ section_state(status) }}{% endif %}
{% set next_run = s.next_candidate_run() %}
{% set quota = s.quota() %}
<div class="strip{{ ' stale' if status.failure }}">
{% for c in s.collections() %}
<span class="chip" title="{{ c.sport }} collection: {{ c.state }}, {{ c.sources }} live source{{ 's' if c.sources != 1 }}
last snapshot {{ c.last_snapshot | stamp }}"><span class="dot {{ c.state }}"></span>{{ c.sport }} <span class="num">{{ 'unknown' if c.last_snapshot is none else ago(c.last_snapshot, s.now) }}</span></span>
{% endfor %}
{% if next_run %}
<span class="chip" title="{{ next_run.job }}: {{ next_run.state }}
next run {{ next_run.next_run | stamp }}"><span class="dot {{ next_run.state }}"></span>run-candidates next <span class="num">{{ next_run.next_run | hhmm }}</span></span>
{% endif %}
{% if quota %}
<span class="chip" title="summed over {{ s.quotas | length }} key{{ 's' if s.quotas | length != 1 }}; days left is the worst key's">Odds API quota <span class="num">{{ '{:,}'.format(quota.remaining) }} / {{ '{:,}'.format(quota.limit) }}</span> ·
{%- if quota.days_left is not none %} <span class="num">~{{ quota.days_left | round(0) | int }}d</span> left{% elif quota.no_spend %} no spend{% else %} unknown{% endif %}</span>
{% else %}
<span class="chip"><span class="dot unknown"></span>quota unknown</span>
{% endif %}
{% for job in s.problem_jobs() %}
<span class="chip" title="{{ job.name }}: {{ job.state }}
last success {{ job.last_success | stamp }}{% if job.max_hours %} (expected every {{ job.max_hours | round(0) | int }} h){% endif %}"><span class="dot {{ job.state }}"></span>{{ job.name }} <span class="num">{{ 'unknown' if job.last_success is none else ago(job.last_success, s.now) }}</span></span>
{% endfor %}
{% for source in s.problem_sources() %}
<span class="chip" title="{{ source.label }}: {{ source.state }}
last snapshot {{ source.last_snapshot | stamp }}"><span class="dot {{ source.state }}"></span>{{ source.label }} <span class="num">{{ 'unknown' if source.last_snapshot is none else ago(source.last_snapshot, s.now) }}</span></span>
{% endfor %}
<a class="chip more" href="{{ url_path('data_health') }}#status" title="every job, source and quota key, as of {{ status.as_of | clock }}">all &rarr;</a>
</div>
{% endif %}
