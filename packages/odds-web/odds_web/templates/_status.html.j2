{% from "_macros.html.j2" import section_state %}
{% set s = status.value %}
{% if s is none %}{{ section_state(status) }}{% else %}
{% if status.failure %}{{ section_state(status) }}{% endif %}
<div class="strip{{ ' stale' if status.failure }}">
<span class="strip-label">Jobs</span>
{% for job in s.jobs %}
<span class="chip" title="{{ job.name }}
last success {{ job.last_success | stamp }}{% if job.max_hours %} (expected every {{ job.max_hours | round(0) | int }} h){% endif %}
next run {{ job.next_run | stamp }}{% if job.running %}
running now{% endif %}"><span class="dot {{ job.state }}"></span>{{ job.name }} <span class="num">{{ 'unknown' if job.last_success is none else ago(job.last_success, s.now) }}</span>{% if job.running %} <span class="sub">running</span>{% endif %}</span>
{% else %}
<span class="chip"><span class="dot unknown"></span>no schedules in the scheduler's store</span>
{% endfor %}
</div>
<div class="strip{{ ' stale' if status.failure }}">
<span class="strip-label">Sources</span>
{% for source in s.sources %}
<span class="chip" title="{{ source.label }}: {{ source.state }}
last snapshot {{ source.last_snapshot | stamp }}{% if source.threshold_hours %}
stale after {{ '%.1f' | format(source.threshold_hours) }} active hours{% endif %}"><span class="dot {{ source.state }}"></span>{{ source.label }} <span class="num">{{ 'unknown' if source.last_snapshot is none else ago(source.last_snapshot, s.now) }}</span></span>
{% endfor %}
</div>
<div class="strip{{ ' stale' if status.failure }}">
<span class="strip-label">Odds API</span>
{% for q in s.quotas %}
<span class="chip" title="{% if q.projection %}{{ '{:,.0f}'.format(q.projection.per_day) }} a day since {{ q.projection.since | stamp }}{% else %}under a day of readings since the last reset{% endif %}">key {{ q.key_index }} ({{ q.sports | join(', ') }}) <span class="num">{{ '{:,}'.format(q.remaining) }} / {{ '{:,}'.format(q.limit) }}</span> ·
{%- if q.projection is none %} unknown{% elif q.projection.days_left is none %} no spend{% else %} <span class="num">~{{ q.projection.days_left | round(0) | int }}d</span> left{% endif %}</span>
{% else %}
<span class="chip"><span class="dot unknown"></span>quota unknown</span>
{% endfor %}
{% if not status.failure %}<span class="sub">as of {{ status.as_of | clock }}</span>{% endif %}
</div>
{% endif %}
