[Unit]
Description=Odds pipeline local scheduler (APScheduler)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Replace with the deploying user and the absolute repo path on the host.
# Settings read .env from WorkingDirectory; an EnvironmentFile= would override
# them without expanding ${VAR} references.
User=andrew
WorkingDirectory=/home/andrew/odds
# systemd requires an absolute path to the executable (`which uv`).
ExecStart=/home/andrew/.local/bin/uv run odds scheduler start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
